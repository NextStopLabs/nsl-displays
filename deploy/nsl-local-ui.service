[Unit]
Description=NSL local controller (192.168.4.1)
After=network.target
[Service]
Type=simple
# Listen everywhere; local_ui.py only serves loopback + AP subnet + bus LAN
# (403 otherwise). Override the bind via a drop-in if needed:
#   Environment="NSL_UI_HOST=127.0.0.1" Environment="NSL_UI_PORT=8080"
Environment="NSL_UI_HOST=0.0.0.0"
Environment="NSL_UI_PORT=80"
ExecStart=/usr/bin/python3 -m uvicorn nsl_pi.local_ui:app --host ${NSL_UI_HOST} --port ${NSL_UI_PORT}
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
