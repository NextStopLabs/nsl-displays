# Public site + portal proxy. DOMAIN / ACME_EMAIL come from deploy/.env
# (passed through as container env). Pi agents talk to https://{$DOMAIN}/portal.
# Humans use the marketing site at / and the cloud portal at /cloud.
{$DOMAIN} {
	tls {$ACME_EMAIL}
	encode gzip
	handle /portal/* {
		uri strip_prefix /portal
		reverse_proxy portal:8000
	}
	handle /cloud {
		redir /cloud/ permanent
	}
	handle /cloud/* {
		uri strip_prefix /cloud
		reverse_proxy portal:8000
	}
# Golden images + checksums. Publish with: cp nsl-*.img.xz* deploy/images/
# then https://{$DOMAIN}/images/nsl-front.img.xz is downloadable.
	handle /images/* {
		uri strip_prefix /images
		root * /srv/images
		file_server browse
	}
	handle {
		root * /srv/site
		file_server
	}
}
