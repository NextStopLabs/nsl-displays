# Public portal config. Copy to .env and fill in:  cp .env.example .env
# Never commit .env — PORTAL_SECRET signs user sessions AND Pi device tokens.

# Public hostname the portal answers on (DNS A record must point here).
DOMAIN=nsldisplays.com
# Email for Let's Encrypt expiry notices.
ACME_EMAIL=ops@example.com
# Generate: openssl rand -hex 32. Changing it later logs everyone out and
# invalidates every paired bus (device tokens stop verifying — re-pair).
PORTAL_SECRET=change-me-to-32-random-bytes-min-32-chars
