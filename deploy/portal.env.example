# NSL portal environment. Copy to /etc/nsl/portal.env and fill in.
# Never commit the real file - PORTAL_SECRET signs user sessions AND Pi device tokens.
#
# Generate a secret: openssl rand -hex 32
# Rotating it later logs everyone out and invalidates every paired bus (re-pair).
PORTAL_SECRET=change-me-to-32-random-bytes-min-32-chars
# SQLite file + file blobs. The unit creates /var/lib/nsl-portal on start.
DATABASE_URL=sqlite:/var/lib/nsl-portal/portal.db
STORAGE_DIR=/var/lib/nsl-portal/storage
# Ed25519 private key for signing OTA software bundles. Either PEM text or a
# 64-byte hex string. Generate a key pair with: python3 tools/generate-release-key.py
# Keep this secret; install the generated release.pub on each Pi.
NSL_RELEASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----
NSL_RELEASE_PRIVATE_KEY=MC4CAQAwBQYDK2VwBCIE...
